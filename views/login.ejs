<!doctype html>
<html>
<head><meta charset="utf-8"><title>Login</title></head>
<body>
<div class="card">
<h1>Login</h1>
<form id="loginForm">
    <label>Email</label><input id="email" name="email"/><br/>
    <label>Password</label><input id="password" name="password" type="password"/><br/>
    <button type="submit">Login</button>
</form>
</div>
<script>
    document.getElementById('loginForm').addEventListener('submit', async e=> {
        e.preventDefault();
        const res = await fetch('/auth/login', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({email:email.value,password:password.value})});
        const data = await res.json();
        alert(data.msg || JSON.stringify(data));
        if(res.ok) window.location='/favorites';
    });
</script>
</body>
</html>