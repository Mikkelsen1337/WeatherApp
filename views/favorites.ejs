<!doctype html>
<html>
<head><meta charset="utf-8"><title>Favorites</title></head>
<body>
<h1>Favorites</h1>
<form id="addFav">
    <input id="city" name="city" placeholder="By"/>
    <button type="submit">Tilføj</button>
</form>
<ul id="list"></ul>
<button id="deleteAccount">Slet konto</button>
<script>
    async function load() {
        const res = await fetch('/api/favorites');
        if(!res.ok) { alert('Du skal være logget ind'); window.location='/login'; return; }
        const data = await res.json();
        const ul = document.getElementById('list');
        ul.innerHTML = '';
        data.favorites.forEach(f => {
            const li = document.createElement('li');
            li.textContent = f.city;
            const btn = document.createElement('button');
            btn.textContent = 'Slet';
            btn.onclick = async () => {
                const r = await fetch('/api/favorites/' + f._id, {method:'DELETE'});
                if(r.ok) load();
                else alert('Fejl');
            };
            li.appendChild(btn);
            ul.appendChild(li);
        });
    }
    document.getElementById('addFav').addEventListener('submit', async e=>{
        e.preventDefault();
        const city = document.getElementById('city').value;
        const res = await fetch('/api/favorites', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({city})});
        const d = await res.json();
        alert(d.msg || JSON.stringify(d));
        if(res.ok) load();
    });
    document.getElementById('deleteAccount').addEventListener('click', async ()=>{
        if(!confirm('Slet konto?')) return;
        const res = await fetch('/auth/delete', {method:'DELETE'});
        const d = await res.json();
        alert(d.msg || JSON.stringify(d));
        if(res.ok) window.location='/';
    });
    load();
</script>
</body>
</html>
